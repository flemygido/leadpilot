# =============================================================================
# LeadPilot Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://leadpilot:password@localhost:5432/leadpilot

# --- AI / LLM ---
# Anthropic API key — get from https://console.anthropic.com/
# If absent, MockLLM is used automatically.
ANTHROPIC_API_KEY=

# --- WhatsApp Provider ---
# Which provider to use: mock | meta | twilio
WHATSAPP_PROVIDER=mock

# --- Meta Cloud API (only needed when WHATSAPP_PROVIDER=meta) ---
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_VERIFY_TOKEN=leadpilot_webhook_verify

# --- Twilio (only needed when WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Auth (NextAuth.js) ---
# Generate: openssl rand -hex 32
AUTH_SECRET=replace_with_random_32_byte_hex
# Shared secret between Next.js proxy and Fastify API
INTERNAL_API_SECRET=replace_with_another_random_32_byte_hex

# --- Agency Configuration ---
AGENCY_CITY=Pune

# --- API Server ---
API_PORT=3001
API_HOST=0.0.0.0

# --- Scheduler ---
FOLLOWUP_CRON=*/5 * * * *

# --- Agent Notification ---
AGENT_WHATSAPP_NUMBER=+910000000000

# --- Logging ---
LOG_LEVEL=info

# --- Next.js web app ---
# In production: your Railway API URL e.g. https://leadpilot-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001
